{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "svelte", "node", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@components": ["./src/lib/components"],
      "@components/*": ["./src/lib/components/*"],
      "@modules/*": ["./src/modules/*"],
      "@stores/*": ["./src/stores/*"],
      "@styles/*": ["./src/styles/*"],
      "@shared-components/*": ["./shared-components/*"],
      "@strixun/feature-flags": ["./packages/feature-flags/src/index.ts"],
      "@strixun/api-framework": ["./packages/api-framework/index.ts"],
      "@strixun/api-framework/client": ["./packages/api-framework/client.ts"],
      "@strixun/api-framework/enhanced": ["./packages/api-framework/enhanced.ts"],
      "@strixun/api-framework/jwt": ["./packages/api-framework/jwt.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.test.ts",
    "shared-components/**/*.test.ts",
    "scripts/**/*.test.js",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}