{
  "name": "@strixun/feature-flag-service",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "esbuild worker.ts --bundle --format=esm --outfile=dist/worker.js --platform=neutral --external:cloudflare:*",
    "predev": "pnpm --filter @strixun/feature-flags build && pnpm --filter @strixun/api-framework build && pnpm run build:worker",
    "dev": "wrangler dev --port 8797 --local --env development",
    "deploy": "pnpm run build:worker && wrangler deploy",
    "deploy:prod": "pnpm run build:worker && wrangler deploy"
  },
  "dependencies": {
    "@strixun/api-framework": "workspace:*",
    "@strixun/feature-flags": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}